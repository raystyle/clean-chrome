 void ChromeDevToolsManagerDelegate::AcceptDebugging(AcceptCallback callback) {
+  // --auto-allow-devtools-connections: skip the consent dialog, accept every
+  // incoming remote debugging connection. Local automation build only.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kAutoAllowDevtoolsConnections)) {
+    std::move(callback).Run(
+        content::DevToolsManagerDelegate::AcceptConnectionResult::kAllow);
+    return;
+  }
